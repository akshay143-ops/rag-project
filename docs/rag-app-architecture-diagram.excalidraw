      "link": null,
      "locked": false,
      "text": "Streamlit UI (app.py)\\n  -> RAG Pipeline (rag_pipeline.py)\\n  -> Input Security (security.py)\\n  -> Conversation Memory (conversation.py)\\n  -> Query Rewriting (workflow.py)\\n  -> Embeddings (embeddings.py)\\n  -> Vector Store / ChromaDB (vector_store.py)\\n  -> Source Documents (data_loader.py)\\n  -> Similarity Filtering + Fallbacks (filters.py)\\n  -> Gemini Model generates grounded answer\\n  -> Monitoring checks confidence + grounding (monitoring.py)\\n  -> Streamlit displays answer, sources, confidence, and warnings",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Streamlit UI (app.py)\\n  -> RAG Pipeline (rag_pipeline.py)\\n  -> Input Security (security.py)\\n  -> Conversation Memory (conversation.py)\\n  -> Query Rewriting (workflow.py)\\n  -> Embeddings (embeddings.py)\\n  -> Vector Store / ChromaDB (vector_store.py)\\n  -> Source Documents (data_loader.py)\\n  -> Similarity Filtering + Fallbacks (filters.py)\\n  -> Gemini Model generates grounded answer\\n  -> Monitoring checks confidence + grounding (monitoring.py)\\n  -> Streamlit displays answer, sources, confidence, and warnings",
      "lineHeight": 1.25
    },
